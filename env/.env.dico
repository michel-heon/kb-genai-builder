# Copier ce fichier vers env/.env.local pour définir des surcharges propres au poste.
# Ne jamais placer de jeton OAuth ni de secret dans ce fichier d’exemple.

# KB_GENAI_BUILDER_RCLONE_BIN='/chemin/vers/rclone'
# KB_GENAI_BUILDER_RCLONE_LOG_DIR='/chemin/vers/les/journaux/rclone'
# KB_GENAI_BUILDER_RCLONE_REMOTE='remote:dossier'
# KB_GENAI_BUILDER_WORKSPACE_DIR='workspace/08-KB-NéoSanté'
# KB_GENAI_BUILDER_RCLONE_READ_ONLY='true'

# Profil public CodeBio. Les chemins relatifs sont résolus depuis la racine du projet.
# Les secrets éventuels restent exclusivement dans env/.env.user.dico.

KB_GENAI_BUILDER_WORKSPACE_DIR='workspace/KB-WORK'
KB_GENAI_BUILDER_MARKDOWN_INPUT_DIR='workspace/KB-WORK'
KB_GENAI_BUILDER_MARKDOWN_OUTPUT_DIR='workspace/KB-WORK/entries'
KB_GENAI_BUILDER_RCLONE_REMOTE='cotechnoe:08-KB-NéoSanté'
KB_GENAI_BUILDER_RCLONE_READ_ONLY='false'

# Extraction déterministe d'une entrée du dictionnaire CodeBio.
KB_GENAI_BUILDER_CODEBIO_WORK_DIR='workspace/KB-WORK'
KB_GENAI_BUILDER_CODEBIO_TABLE_OF_CONTENTS_PDF='workspace/KB-WORK/Dictionnaire des codes biologies des maladies - Table des Matières.pdf'
KB_GENAI_BUILDER_CODEBIO_TABLE_OF_CONTENTS_MARKDOWN='workspace/KB-WORK/Dictionnaire des codes biologies des maladies - Table des Matières.md'
KB_GENAI_BUILDER_CODEBIO_DICTIONARY_PDF='workspace/KB-WORK/Dictionnaire des codes biologies des maladies.pdf'
KB_GENAI_BUILDER_CODEBIO_ENTRY_STRUCTURE='workspace/KB-WORK/codebio-entry-structure.properties'
KB_GENAI_BUILDER_CODEBIO_ENTRY='Amylase'
KB_GENAI_BUILDER_CODEBIO_ENTRY_OUTPUT_DIR='workspace/KB-WORK/entries'
KB_GENAI_BUILDER_CODEBIO_INDEX_RESOLUTIONS='workspace/KB-WORK/codebio-index-resolutions.properties'
KB_GENAI_BUILDER_CODEBIO_FAILURE_LIST='workspace/KB-WORK/entries/echecs-extraction.md'